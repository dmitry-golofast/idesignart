# ===== Caddy — Reverse Proxy + Auto SSL =====
#
# Caddy автоматически получает SSL-сертификаты от Let's Encrypt
# и продлевает их без настройки.
#
# Всё живёт на одном домене:
#   idesignart.com        → сайт (Nuxt) + админка (Payload) на /admin
#   www.idesignart.com    → редирект на idesignart.com
#   admin.idesignart.com  → временный 308-редирект на основной домен
#                           (после переезда блок и DNS-запись A admin можно удалить)

# ===== Сайт + админка (один домен) =====
{$SITE_DOMAIN} {
	encode zstd gzip

	# Sitemap-роут Nuxt — раньше общего правила /api/* (там отдаёт Payload)
	handle /api/__sitemap__/* {
		reverse_proxy web:3000
	}

	# Payload CMS: админка (/admin), REST/GraphQL API, статика Next (/_next), медиа
	@payload {
		path /admin* /_next/* /api/* /graphql* /media/*
	}
	handle @payload {
		reverse_proxy admin:3001

		# Media-файлы (загруженные через Payload)
		@media {
			path /api/media/* /media/*
		}
		header @media Cache-Control "public, max-age=86400"
	}

	# Всё остальное — Nuxt (сайт)
	handle {
		reverse_proxy web:3000

		# Кэшируем статику
		@static {
			path /_nuxt/* /_ipx/* /favicon.ico /robots.txt /sitemap.xml
		}
		header @static Cache-Control "public, max-age=31536000, immutable"
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format console
	}
}

# ===== www → редирект на основной домен =====
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# ===== Старый админ-домен → редирект на основной (временный) =====
# Держит работоспособность старых ссылок на админку и зашитых URL медиа.
# Через месяц-два после переезда: удалить этот блок и DNS-запись A admin.
{$ADMIN_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
